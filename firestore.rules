rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Users Collection Rules ---
    match /users/{userId} {
      // ADMIN PERMISSION: Allow admins to manage all users (read, create, update, delete)
      allow read, write: if request.auth != null 
                          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      // Allow new users to create self document OR recruiters to create secondary recruiters
      allow create: if request.auth != null && (
                      (request.auth.uid == userId && request.resource.data.role in ['candidate', 'recruiter']) ||
                      (request.resource.data.parentRecruiterId == request.auth.uid) ||
                      (request.resource.data.teamId == request.auth.uid)
                    );

      // Self management and team recruiter permissions
      allow read: if request.auth != null && (
                    request.auth.uid == userId ||
                    resource.data.teamId == request.auth.uid ||
                    resource.data.parentRecruiterId == request.auth.uid ||
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'recruiter'
                  );

      allow update, delete: if request.auth != null && (
                             request.auth.uid == userId ||
                             resource.data.parentRecruiterId == request.auth.uid ||
                             resource.data.teamId == request.auth.uid
                           );
    }

    // --- Recruiter Requests ---
    match /recruiterRequests/{requestId} {
      allow create: if true;
      allow read, write: if request.auth != null 
                          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- Audit Logs Collection ---
    match /auditLogs/{logId} {
      allow read, write: if request.auth != null;
    }

    // --- Candidate Consent Receipts ---
    match /candidateConsents/{consentId} {
      allow create: if true;
      allow read: if request.auth != null;
    }

    // --- Profiles Collection Rules ---
    match /profiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // --- Jobs Collection Rules ---
    match /jobs/{jobId} {
      allow read, create, update, delete: if true;
    }

    // --- Interviews Collection Rules ---
    match /interviews/{interviewId} {
        allow read, create, update, delete: if true;

        // --- Attempts Subcollection Rules ---
        match /attempts/{attemptId} {
            // Allow anyone to create a submission, required for "open" interviews
            allow create: if true;
            // Allow anyone to read a report. This makes report links public.
            allow read: if true;
            // Allow updating attempt status or reattempt permissions
            allow update: if true;
            allow delete: if true;
        }
    }

    // --- Candidate Responses Collection Rules (Top-level attempts mirror) ---
    match /candidateResponses/{submissionId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // --- Collection Group Rules ---
    match /{path=**}/attempts/{attemptId} {
      allow read: if true;
    }

    // --- Interview Requests Collection Rules ---
    match /interviewRequests/{requestId} {
      allow read, write: if request.auth != null;
    }

    // --- Notifications Collection Rules ---
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // --- Recruiter Resume Dump ---
    match /resumeDumpCandidates/{candidateId} {
      allow read, write: if true;
    }

    match /resumeDump/{candidateId} {
      allow read, write: if true;
    }

    // --- Transactions Collection Rules ---
    match /transactions/{transactionId} {
      allow create, read, update: if request.auth != null;
    }

    // --- Chat Sessions (AI Agent) ---
    match /chatSessions/{sessionId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    // --- Blogs Collection Rules ---
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // --- Tests (Aptitude/Coding) ---
    match /tests/{testId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /testSubmissions/{submissionId} {
      allow create: if true;
      allow read: if true;
      allow update: if true;
    }

    // --- Interview Access Tokens ---
    match /interviewAccessTokens/{tokenId} {
      allow create: if true;
      allow read: if true;
      allow update: if true;
    }

    // --- Contact Submissions ---
    match /contactSubmissions/{submissionId} {
      allow create: if true;
      allow read, write: if request.auth != null;
    }

    // --- Bug Reports ---
    match /bugReports/{reportId} {
      allow create: if true;
      allow read, write: if request.auth != null;
    }

    // --- Reviews Collection Rules ---
    match /reviews/{reviewId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if request.auth != null;
    }

    // --- Settings Collection Rules ---
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // --- Shared Company Rate Limits ---
    match /rateLimits/{rateLimitId} {
      allow read, write: if true;
    }
  }
}
