rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Users Collection Rules ---
    match /users/{userId} {
      // ADMIN PERMISSION: Allow admins to manage all users (read, create, update, delete)
      allow read, write: if request.auth != null 
                          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      // Existing: Allow new users to create their own document
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role in ['candidate', 'recruiter'];

      // Existing: Self management
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;

      // Existing: Recruiter permissions
      allow read: if request.auth != null
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'recruiter';

      allow update: if request.auth != null
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'recruiter'
                    && resource.data.role == 'candidate'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountStatus', 'updatedAt']);

      allow delete: if request.auth != null
                     && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'recruiter'
                     && resource.data.role == 'candidate';
    }

    // --- Recruiter Requests (New for Admin Dashboard) ---
    match /recruiterRequests/{requestId} {
      // Allow anyone to create a request (public signup)
      allow create: if true;
      
      // Only admins can read or modify requests
      allow read, write: if request.auth != null 
                          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- Candidate Consent Receipts ---
    match /candidateConsents/{consentId} {
      function isValidCandidateConsent(data) {
        return data.keys().hasOnly([
                 'interviewId',
                 'interviewTitle',
                 'candidateName',
                 'candidateEmail',
                 'ipAddress',
                 'acceptedItemIds',
                 'acceptedAll',
                 'consentVersion',
                 'consentMethod',
                 'status',
                 'acceptedAt',
                 'createdAt'
               ])
               && data.interviewId is string
               && data.interviewId.size() > 0
               && data.interviewId.size() <= 128
               && exists(/databases/$(database)/documents/interviews/$(data.interviewId))
               && data.interviewTitle is string
               && data.interviewTitle.size() <= 300
               && data.candidateName is string
               && data.candidateName.size() > 0
               && data.candidateName.size() <= 200
               && data.candidateEmail is string
               && data.candidateEmail.size() > 2
               && data.candidateEmail.size() <= 320
               && data.candidateEmail.matches('.*@.*')
               && (data.ipAddress == null || (
                    data.ipAddress is string
                    && data.ipAddress.matches('^[0-9A-Fa-f:.]{2,64}$')
                  ))
               && data.acceptedItemIds is list
               && data.acceptedItemIds.hasOnly([
                    'continuous_recording',
                    'ai_processing',
                    'recruiting_company_sharing'
                  ])
               && data.acceptedItemIds.hasAll([
                    'continuous_recording',
                    'ai_processing',
                    'recruiting_company_sharing'
                  ])
               && data.acceptedAll == true
               && data.consentVersion == '2026-07-17'
               && data.consentMethod == 'web_checkboxes'
               && data.status == 'accepted'
               && data.acceptedAt is timestamp
               && data.acceptedAt <= request.time
               && data.acceptedAt > request.time - duration.value(1, 'd')
               && data.createdAt == request.time;
      }

      allow create: if isValidCandidateConsent(request.resource.data);
      allow read: if request.auth != null
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- Profiles Collection Rules ---
    match /profiles/{userId} {
      // Admin Permission
      allow read, write: if request.auth != null 
                          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // --- Jobs Collection Rules ---
    match /jobs/{jobId} {
      // Admin Permission
      allow write: if request.auth != null 
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      allow read: if true;
      // Allow recruiters to create jobs, and any authenticated user to create a mock job.
      allow create: if request.auth != null && (
                      (request.resource.data.recruiterUID == request.auth.uid) ||
                      (request.resource.data.isMock == true)
                    );
      allow update, delete: if request.auth != null
                             && resource.data.recruiterUID == request.auth.uid;
    }

    // --- Interviews Collection Rules ---
    match /interviews/{interviewId} {
        allow read: if true;

        // Admin Permission
        allow write: if request.auth != null 
                          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

        // Recruiter who created the interview can do anything
        allow update, delete: if request.auth != null && resource.data.recruiterUID == request.auth.uid;
        
        // Allow recruiters to create interviews, and any authenticated user to create a mock interview.
        allow create: if request.auth != null && (
                      (request.resource.data.recruiterUID == request.auth.uid) ||
                      (request.resource.data.isMock == true)
                    );

        // --- Attempts Subcollection Rules ---
        match /attempts/{attemptId} {
            // Allow anyone to create a submission, required for "open" interviews
            allow create: if true;

            // Allow anyone to read a report. This makes report links public.
            allow read: if true;

            // Allow the recruiter who owns the job/interview to update the submission status/reattempts, or anyone to consume a reattempt flag.
            allow update: if (
                              request.auth != null
                              && get(/databases/$(database)/documents/interviews/$(interviewId)).data.recruiterUID == request.auth.uid
                              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'allowReattempt'])
                              && (resource.data.status != 'Shortlist' || request.resource.data.status == 'Shortlist')
                            ) || (
                              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['allowReattempt'])
                              && resource.data.allowReattempt == true
                              && request.resource.data.allowReattempt == false
                            );
        }
    }

    // --- Collection Group Rules ---
    // Allow candidates to query their own attempts and admins to reconcile
    // company-wide candidate usage across every interview.
    match /{path=**}/attempts/{attemptId} {
      allow read: if request.auth != null
                  && (
                       request.auth.uid == resource.data.candidateUID
                       || request.auth.uid == resource.data.recruiterUID
                       || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
                     );
    }

    // --- Interview Requests Collection Rules ---
    match /interviewRequests/{requestId} {
      // Admin Permission
      allow read, write: if request.auth != null 
                          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      allow create: if request.auth != null
                    && request.resource.data.candidateUID == request.auth.uid
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'candidate'
                    && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.recruiterUID == request.resource.data.recruiterUID;

      allow read: if request.auth != null
                  && (
                        request.auth.uid == resource.data.recruiterUID
                        ||
                        request.auth.uid == resource.data.candidateUID
                     );

      allow update: if request.auth != null
                    && request.auth.uid == resource.data.recruiterUID
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt', 'updatedAt']);
    }

    // --- Notifications Collection Rules ---
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // --- Recruiter Resume Dump ---
    match /resumeDumpCandidates/{candidateId} {
      function isValidCandidateInterviewResume(data) {
        return data.keys().hasOnly([
                 'name', 'email', 'phone', 'location', 'currentTitle', 'summary',
                 'totalExperienceYears', 'skills', 'experience', 'education',
                 'certifications', 'languages', 'keywords', 'linkedinUrl',
                 'portfolioUrl', 'parsingMethod', 'parserVersion', 'recruiterUID',
                 'resumeUrl', 'resumeFileName', 'resumeMimeType', 'resumeSize',
                 'resumeText', 'source', 'sourceInterviewId', 'sourceJobTitle',
                 'createdAt', 'updatedAt'
               ])
               && data.source == 'candidate_interview'
               && data.sourceInterviewId is string
               && data.recruiterUID is string
               && data.name is string && data.name.size() <= 200
               && data.email is string && data.email.size() <= 320
               && data.phone is string && data.phone.size() <= 80
               && data.resumeUrl is string && data.resumeUrl.size() <= 5000
               && data.resumeText is string && data.resumeText.size() <= 25000
               && data.skills is list && data.skills.size() <= 50
               && data.experience is list && data.experience.size() <= 12
               && data.education is list && data.education.size() <= 10
               && data.totalExperienceYears is number
               && data.totalExperienceYears >= 0 && data.totalExperienceYears <= 60
               && exists(/databases/$(database)/documents/interviews/$(data.sourceInterviewId))
               && get(/databases/$(database)/documents/interviews/$(data.sourceInterviewId)).data.recruiterUID == data.recruiterUID;
      }

      function sameCandidateIdentity(existing, incoming) {
        return (incoming.email is string && incoming.email.size() > 0 && existing.email == incoming.email)
            || (incoming.phone is string && incoming.phone.size() > 0 && existing.phone == incoming.phone)
            || (
                 (incoming.email.size() == 0 && existing.email.size() == 0)
                 && (incoming.phone.size() == 0 && existing.phone.size() == 0)
                 && incoming.name == existing.name
               );
      }

      allow read, write: if request.auth != null 
                          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      allow create: if (
                      request.auth != null
                      && request.resource.data.recruiterUID == request.auth.uid
                      && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'recruiter'
                    ) || isValidCandidateInterviewResume(request.resource.data);

      allow update: if (
                      request.auth != null
                      && resource.data.recruiterUID == request.auth.uid
                      && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'recruiter'
                    ) || (
                      isValidCandidateInterviewResume(request.resource.data)
                      && resource.data.recruiterUID == request.resource.data.recruiterUID
                      && sameCandidateIdentity(resource.data, request.resource.data)
                    );

      allow get: if request.auth != null
                 && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'recruiter'
                 && (resource == null || resource.data.recruiterUID == request.auth.uid);

      allow list, delete: if request.auth != null
                          && resource.data.recruiterUID == request.auth.uid
                          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'recruiter';
    }

    // --- Transactions Collection Rules ---
    match /transactions/{transactionId} {
      // Allow authenticated users to create transaction records (e.g. after payment)
      allow create: if request.auth != null;
      
      // Admins can read all transactions. Users can read their own.
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // --- Chat Sessions (AI Agent) ---
    match /chatSessions/{sessionId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    // --- Blogs Collection Rules ---
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if request.auth != null 
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- Tests (Aptitude/Coding) ---
    match /tests/{testId} {
      allow read: if true;
      // Allow recruiters to manage tests OR candidates to create/manage their own mock tests
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null 
                    && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'recruiter'
                        || resource.data.recruiterUID == request.auth.uid);
    }

    match /testSubmissions/{submissionId} {
      allow create: if true;
      // Allow public read to enable the Student Results portal where candidates search by email
      allow read: if true;
    }

    // --- Interview Access Tokens (generated when candidate passes an assessment) ---
    match /interviewAccessTokens/{tokenId} {
      // Allow anyone to create a token (anonymous candidates taking open assessments)
      allow create: if true;
      // Allow reading for interview access validation
      allow read: if true;
      // Only allow update by authenticated users (e.g., marking token as used)
      allow update: if request.auth != null;
    }

    // --- Contact Submissions ---
    match /contactSubmissions/{submissionId} {
      allow create: if true;
      allow read, write: if request.auth != null 
                          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- Bug Reports ---
    match /bugReports/{reportId} {
      allow create: if true;
      allow read, write: if request.auth != null 
                          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- Reviews Collection Rules ---
    match /reviews/{reviewId} {
      // Anyone can submit a review, but we validate the data.
      allow create: if request.resource.data.name is string
              && request.resource.data.name.size() > 0
              && request.resource.data.review is string
              && request.resource.data.review.size() > 0
              && request.resource.data.rating is number
              && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
              && request.resource.data.userType in ['student', 'candidate', 'recruiter']
              && request.resource.data.approved == false;
      // Public can read approved reviews. Admins can read all reviews.
      allow read: if resource.data.approved == true ||
                   (request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      // Only admins can update (approve) or delete reviews
      allow update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- Settings Collection Rules ---
    match /settings/{settingId} {
      // Admin Permission: Admins can read/write universal pricing or configuration settings
      allow read, write: if request.auth != null 
                          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- Shared Company Rate Limits ---
    match /rateLimits/{rateLimitId} {
      function isAdmin() {
        return request.auth != null
               && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }

      function hasValidLimits(data) {
        return data.interviews is int && data.interviews >= 0
               && data.assessments is int && data.assessments >= 0
               && data.codingAssessments is int && data.codingAssessments >= 0;
      }

      function hasValidUsage(data) {
        return data.usage.interviews is int && data.usage.interviews >= 0
               && data.usage.assessments is int && data.usage.assessments >= 0
               && data.usage.codingAssessments is int && data.usage.codingAssessments >= 0;
      }

      function hasValidUsageBaseline(data) {
        return data.usageBaseline.interviews is int && data.usageBaseline.interviews >= 0
               && data.usageBaseline.assessments is int && data.usageBaseline.assessments >= 0
               && data.usageBaseline.codingAssessments is int && data.usageBaseline.codingAssessments >= 0;
      }

      function isInitialPublicConsumption() {
        return request.resource.data.scope == 'company'
               && request.resource.data.interviews == 2500
               && request.resource.data.assessments == 5
               && request.resource.data.codingAssessments == 2
               && request.resource.data.topUps.interviews == 0
               && request.resource.data.topUps.assessments == 0
               && request.resource.data.topUps.codingAssessments == 0
               && request.resource.data.usageBaseline.interviews == 0
               && request.resource.data.usageBaseline.assessments == 0
               && request.resource.data.usageBaseline.codingAssessments == 0
               && hasValidUsage(request.resource.data)
               && hasValidUsageBaseline(request.resource.data)
               && request.resource.data.usage.interviews <= request.resource.data.interviews
               && request.resource.data.usage.assessments <= request.resource.data.assessments
               && request.resource.data.usage.codingAssessments <= request.resource.data.codingAssessments
               && request.resource.data.usage.interviews
                  + request.resource.data.usage.assessments
                  + request.resource.data.usage.codingAssessments == 1;
      }

      function isSingleUsageIncrement() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usage', 'lastCandidateSubmissionAt'])
               && hasValidLimits(request.resource.data)
               && hasValidUsage(request.resource.data)
               && hasValidUsageBaseline(request.resource.data)
               && request.resource.data.usageBaseline == resource.data.usageBaseline
               && request.resource.data.usage.interviews <= request.resource.data.interviews
               && request.resource.data.usage.assessments <= request.resource.data.assessments
               && request.resource.data.usage.codingAssessments <= request.resource.data.codingAssessments
               && request.resource.data.usage.interviews >= resource.data.usage.interviews
               && request.resource.data.usage.assessments >= resource.data.usage.assessments
               && request.resource.data.usage.codingAssessments >= resource.data.usage.codingAssessments
               && request.resource.data.usage.interviews - resource.data.usage.interviews <= 1
               && request.resource.data.usage.assessments - resource.data.usage.assessments <= 1
               && request.resource.data.usage.codingAssessments - resource.data.usage.codingAssessments <= 1
               && (request.resource.data.usage.interviews - resource.data.usage.interviews)
                  + (request.resource.data.usage.assessments - resource.data.usage.assessments)
                  + (request.resource.data.usage.codingAssessments - resource.data.usage.codingAssessments) == 1;
      }

      // Recruiter and candidate flows read only the single shared company pool.
      allow get: if rateLimitId == 'company';
      allow list: if isAdmin();

      // Admins manage limits, top-ups, and resets. A candidate flow may only
      // create the default pool or atomically increment exactly one usage slot.
      allow create: if rateLimitId == 'company'
                    && (isAdmin() || isInitialPublicConsumption());
      allow update: if rateLimitId == 'company'
                    && (isAdmin() || isSingleUsageIncrement());
      allow delete: if rateLimitId == 'company' && isAdmin();
    }
  }
}
